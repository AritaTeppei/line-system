generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                       Int                       @id @default(autoincrement())
  name                     String
  email                    String
  plan                     String?                   @default("TRIAL")
  isActive                 Boolean                   @default(true)
  validUntil               DateTime?
  lineAccessToken          String?
  lineChannelId            String?
  lineSecret               String?
  companyAddress1          String?
  companyAddress2          String?
  companyName              String?
  contactMobile            String?
  contactPhone             String?
  representativeName       String?
  currentPeriodEnd         DateTime?
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  subscriptionStatus       String?
  trialEnd                 DateTime?
  trialEndNotifiedAt       DateTime?
  nextPlan                 String?
  nextPlanStartAt          DateTime?
  bookings                 Booking[]
  broadcastLogs            BroadcastLog[]
  cars                     Car[]
  customers                Customer[]
  customerRegisterTokens   CustomerRegisterToken[]
  lineBookingTokens        LineBookingToken[]
  lineSettings             LineSettings?
  messageLogs              MessageLog[]
  reminderMessageTemplates ReminderMessageTemplate[]
  reminderSentLogs         ReminderSentLog[]
  users                    User[]
}

model User {
  id                    Int           @id @default(autoincrement())
  tenantId              Int?
  email                 String        @unique
  name                  String?
  createdAt             DateTime      @default(now())
  password              String
  role                  UserRole      @default(MANAGER)
  isActive              Boolean       @default(true)
  maxConcurrentSessions Int           @default(1)
  plan                  Plan?         @default(BASIC)
  tenant                Tenant?       @relation(fields: [tenantId], references: [id])
  sessions              UserSession[]
  passwordResetTokens   PasswordResetToken[]
}

model UserSession {
  id        Int       @id @default(autoincrement())
  userId    Int
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id])
}

model Customer {
  id                    Int                    @id @default(autoincrement())
  tenantId              Int
  lastName              String
  firstName             String
  postalCode            String?
  address1              String?
  address2              String?
  mobilePhone           String?
  lineUid               String?
  birthday              DateTime?
  bookings              Booking[]
  broadcastLogCustomers BroadcastLogCustomer[]
  cars                  Car[]
  tenant                Tenant                 @relation(fields: [tenantId], references: [id])
  messageLogs           MessageLog[]
  reminderSentLogs      ReminderSentLog[]

  @@unique([tenantId, lineUid], map: "customer_tenant_lineuid_unique")
  @@unique([tenantId, mobilePhone], map: "customer_tenant_mobile_unique")
}

model CustomerRegisterToken {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  lineUid   String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model LineBookingToken {
  id        Int       @id @default(autoincrement())
  tenantId  Int
  lineUid   String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model Car {
  id                 Int               @id @default(autoincrement())
  tenantId           Int
  customerId         Int
  registrationNumber String
  chassisNumber      String            @unique(map: "car_chassis_unique")
  carName            String
  customDaysBefore   Int?
  customReminderDate DateTime?
  inspectionDate     DateTime?
  shakenDate         DateTime?
  bookings           Booking[]
  customer           Customer          @relation(fields: [customerId], references: [id])
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  messageLogs        MessageLog[]
  reminderSentLogs   ReminderSentLog[]
}

model MessageLog {
  id          Int         @id @default(autoincrement())
  tenantId    Int
  customerId  Int?
  carId       Int?
  lineUid     String?
  messageType MessageType
  content     String
  createdAt   DateTime    @default(now())
  car         Car?        @relation(fields: [carId], references: [id])
  customer    Customer?   @relation(fields: [customerId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
}

model Booking {
  id                      Int           @id @default(autoincrement())
  tenantId                Int
  customerId              Int?
  carId                   Int?
  bookingDate             DateTime
  timeSlot                String?
  status                  BookingStatus @default(PENDING)
  source                  String?
  note                    String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  confirmationLineMessage String?
  confirmationLineSentAt  DateTime?
  needsLoanerCar          Boolean       @default(false)
  purpose                 String?
  guestName               String?
  guestPhone              String?
  lineUid                 String?
  car                     Car?          @relation(fields: [carId], references: [id])
  customer                Customer?     @relation(fields: [customerId], references: [id])
  tenant                  Tenant        @relation(fields: [tenantId], references: [id])
}

model LineSettings {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @unique
  channelId     String?
  channelSecret String?
  accessToken   String?
  webhookUrl    String?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  destination   String?
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
}

model ReminderMessageTemplate {
  id        Int                 @id @default(autoincrement())
  tenantId  Int
  type      ReminderMessageType
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  body      String
  note      String?
  title     String?
  tenant    Tenant              @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
}

model BroadcastLog {
  id          Int                    @id @default(autoincrement())
  tenantId    Int
  message     String
  sentCount   Int
  targetCount Int
  createdAt   DateTime               @default(now())
  target      BroadcastTarget        @default(CUSTOMER)
  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  customers   BroadcastLogCustomer[]

  @@index([tenantId, createdAt])
}

model ReminderSentLog {
  id         Int              @id @default(autoincrement())
  tenantId   Int
  date       DateTime
  category   ReminderCategory
  customerId Int?
  carId      Int?
  createdAt  DateTime         @default(now())
  car        Car?             @relation(fields: [carId], references: [id])
  customer   Customer?        @relation(fields: [customerId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
}

model BroadcastLogCustomer {
  id             Int          @id @default(autoincrement())
  broadcastLogId Int
  customerId     Int
  broadcastLog   BroadcastLog @relation(fields: [broadcastLogId], references: [id])
  customer       Customer     @relation(fields: [customerId], references: [id])
}

enum Plan {
  BASIC
  STANDARD
  PRO
}

enum UserRole {
  DEVELOPER
  MANAGER
  CLIENT
}

enum ReminderMessageType {
  BIRTHDAY
  SHAKEN_TWO_MONTHS
  SHAKEN_ONE_WEEK
  INSPECTION_ONE_MONTH
  CUSTOM
}

enum MessageType {
  MANUAL_CUSTOMER
  MANUAL_CAR
  REMINDER_BIRTHDAY
  REMINDER_SHAKEN_2M
  REMINDER_SHAKEN_1W
  REMINDER_INSPECTION_1M
  REMINDER_CUSTOM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
}

enum BroadcastTarget {
  CUSTOMER
  CAR
}

enum ReminderCategory {
  birthday
  shakenTwoMonths
  shakenOneWeek
  inspectionOneMonth
  custom
}
